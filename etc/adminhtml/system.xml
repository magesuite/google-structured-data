<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magesuite" translate="label" sortOrder="300">
            <label>MageSuite</label>
        </tab>
        <section id="structured_data" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Google Structured Data</label>
            <tab>magesuite</tab>
            <resource>MageSuite_GoogleStructuredData::config_structured_data</resource>
            <group id="general" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="id_use_root_domain" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Use Root Domain For @id</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Controls the @id base for the site-wide Organization and WebSite entities. No (default): store base URL (e.g. https://example.com/de/#organization). Yes: root domain (e.g. https://example.com/#organization). <b>Recommended: Yes for multi-language/multi-store setups</b> so the Organization and WebSite are treated as one entity across all store views; use No only when a single domain hosts several distinct brands/sites under different paths.]]></comment>
                </field>
            </group>
            <group id="breadcrumbs" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Breadcrumbs</label>
                <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Is Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines whether a section will be added to the page source code or not.</comment>
                </field>
                <field id="include_homepage" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Include Homepage</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines whether homepage is included as first item in BreadcrumbList.</comment>
                </field>
            </group>
            <group id="organization" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Organization</label>
                <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Is Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines whether a section will be added to the page source code or not.</comment>
                </field>
                <field id="name" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Organization Name</label>
                    <comment>Public brand/company name for the Organization entity. Example: Example Store GmbH. If empty, the store name is used.</comment>
                </field>
                <field id="legal_name" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Legal Name</label>
                </field>
                <field id="logo" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Logo Url</label>
                    <comment>Absolute URL to the company logo (min 112x112px). Example: https://example.com/media/logo.svg. If empty, the theme logo is used.</comment>
                </field>
                <field id="description" translate="label" type="textarea" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Description</label>
                    <comment>Short company description (1-2 sentences). Example: Example Store is an online shop for garden furniture and accessories.</comment>
                </field>
                <field id="alternate_name" translate="label" type="textarea" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Alternate Name</label>
                    <comment>Alternative names of the organization, one per line. Rendered as schema.org alternateName array.</comment>
                </field>
                <field id="founding_date" translate="label" type="text" sortOrder="46" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Founding Date</label>
                    <comment>Year or date the organization was founded, e.g. 2006 or 2006-05-01. Rendered as schema.org foundingDate.</comment>
                </field>
                <field id="telephone" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Telephone</label>
                    <comment>Phone in international format. Example: +49 30 1234567.</comment>
                </field>
                <field id="email" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Email</label>
                    <comment>Contact email. Example: info@example.com.</comment>
                </field>
                <group id="address" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Address</label>
                    <field id="postal" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Postal Code</label>
                        <comment>Example: 10115.</comment>
                    </field>
                    <field id="city" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>City</label>
                        <comment>Example: Berlin.</comment>
                    </field>
                    <field id="street" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Street</label>
                        <comment>Street and number. Example: Example Street 1.</comment>
                    </field>
                    <field id="region" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Region</label>
                        <comment>State/region. Example: Berlin.</comment>
                    </field>
                    <field id="country" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Country</label>
                        <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    </field>
                </group>
                <group id="contact" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Contact</label>
                    <field id="sales_telephone" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Sales Telephone</label>
                        <comment>Example: +49 30 1234567.</comment>
                    </field>
                    <field id="sales_email" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Sales Email</label>
                        <comment>Example: sales@example.com.</comment>
                    </field>
                    <field id="technical_telephone" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Technical Support Telephone</label>
                        <comment>Example: +49 30 1234568.</comment>
                    </field>
                    <field id="technical_email" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Technical Support Email</label>
                        <comment>Example: support@example.com.</comment>
                    </field>
                    <field id="customer_service_telephone" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Customer Service Telephone</label>
                        <comment>Example: +49 30 1234569.</comment>
                    </field>
                    <field id="customer_service_email" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Customer Service Email</label>
                        <comment>Example: service@example.com.</comment>
                    </field>
                    <field id="area_served" translate="label" type="multiselect" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Area Served</label>
                        <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    </field>
                    <field id="available_language" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Available Language</label>
                        <comment>Comma-separated.</comment>
                    </field>
                </group>
                <group id="return_policy" translate="label" type="text" sortOrder="400" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Return Policy</label>
                    <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Defines if return policy data should be displayed in the structured data</comment>
                    </field>
                    <field id="return_policy_category" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Return Policy Category</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\ReturnPolicyCategory</source_model>
                    </field>
                    <field id="return_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <depends>
                            <field id="structured_data/organization/return_policy/return_policy_category">MerchantReturnFiniteReturnWindow</field>
                        </depends>
                        <label>Return Days</label>
                        <comment>This field is only applicable for "Merchant Return Finite Return Window".</comment>
                        <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    </field>
                    <field id="return_method" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Return Method</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\ReturnMethod</source_model>
                    </field>
                    <field id="return_fees" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Return Fees</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\ReturnFees</source_model>
                    </field>
                    <field id="refund_type" translate="label" type="select" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Refund Type</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\ReturnRefundType</source_model>
                        <comment>Optional but recommended by Google. How a refund is issued. Example: Full Refund.</comment>
                    </field>
                    <field id="return_policy_link" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Return Policy Link</label>
                        <comment>When defined it will replace other return policy data.</comment>
                    </field>
                </group>
                <group id="social" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Social Profiles</label>
                    <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Is Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="additional_urls" translate="label" type="textarea" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Additional Profile URLs (sameAs)</label>
                        <comment>Extra URLs identifying the company elsewhere, one per line. Merged into the schema.org sameAs array. Examples: a Trustedshops or Trustpilot review page, or a Wikipedia/Wikidata entry.</comment>
                    </field>
                    <group id="profiles" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Profiles</label>
                        <field id="facebook" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>Facebook</label>
                            <comment>Full url to facebook profile.</comment>
                        </field>
                        <field id="twitter" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>Twitter</label>
                            <comment>Full url to twitter profile.</comment>
                        </field>
                        <field id="instagram" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>Instagram</label>
                            <comment>Full url to instagram profile.</comment>
                        </field>
                        <field id="youtube" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>YouTube</label>
                            <comment>Full url to youtube profile.</comment>
                        </field>
                        <field id="linkedin" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>LinkedIn</label>
                            <comment>Full url to linkedin profile.</comment>
                        </field>
                        <field id="pinterest" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>Pinterest</label>
                            <comment>Full url to pinterest profile.</comment>
                        </field>
                        <field id="tiktok" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                            <label>Tiktok</label>
                            <comment>Full url to tiktok profile.</comment>
                        </field>
                    </group>
                </group>
            </group>
            <group id="website" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WebSite</label>
                <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Is Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines whether the WebSite entity is added to the structured data graph.</comment>
                </field>
                <field id="name" translate="label" type="text" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Name</label>
                    <comment>WebSite name for structured data. If empty, the Magento website name is used, then the Organization name.</comment>
                </field>
                <field id="search_box_enabled" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Search Box / SearchAction (deprecated)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Deprecated: Google retired the Sitelinks Searchbox feature (2024), so this SearchAction markup no longer produces a rich result. When enabled it adds a SearchAction (potentialAction) to the WebSite entity. Requires WebSite enabled.</comment>
                </field>
            </group>

            <group id="category_page" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Category</label>
                <field id="include_products" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Include products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Emits a standalone Product entity for every product on the category page (full product data, NOT wrapped in a list) - this duplicates the product detail pages (PDP). Recommended: No - use "Include ListItem data" instead. Independent of that setting; enabling both duplicates the product markup.</comment>
                </field>
                <field id="include_list_item" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Include ListItem data</label>
                    <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\CategoryListItemMode</source_model>
                    <comment>Emits a single ItemList entity for the products on the category page. Disabled: no ItemList. "Product URLs only" (recommended): lightweight items (position + name + link to each PDP), no data duplication and keeps the PDP as the source of truth. "Full product data": embeds the whole Product in each list item (heavy, duplicates the PDP). Independent of "Include products".</comment>
                </field>
                <field id="show_rating" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show Rating</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds review/aggregateRating to products in the category structured data. Applies only when full product data is emitted (Include ListItem data = "Full product data", or Include products = Yes) - no effect in "Product URLs only". Also requires Show Rating enabled for Product. Recommended: No (rating belongs on the product detail page).</comment>
                </field>
            </group>
            <group id="product_page" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product</label>
                <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Is Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines whether a section will be added to the page source code or not.</comment>
                </field>
                <field id="is_indexing_enabled" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Is Indexing Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines if pregenerated structured data should be stored in index.</comment>
                </field>
                <field id="indexer_cron_schedule" translate="label" type="text" sortOrder="60" showInDefault="1">
                    <label>Indexer Cron Schedule</label>
                    <comment>Please type full cron schedule expression, eg. '59 23 * * *'</comment>
                </field>
                <field id="cache_lifetime" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Cache Lifetime</label>
                    <comment>Defines max cache lifetime in seconds. Set 0 to disable caching in case your project does not modify heavily the data from the index.</comment>
                </field>
                <field id="show_rating" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show Rating</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Defines if rating should be included in structured data.</comment>
                </field>
                <field id="default_price_valid_until_enabled" translate="label" type="select" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Default Price Valid Until</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, products without an active special price get a default priceValidUntil set to one year from today. Does not override the special price end date.</comment>
                </field>
                <group id="attributes" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Attributes</label>
                    <field id="description" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Description</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Attributes</source_model>
                        <comment>Defines which attribute will be used to describe product description.</comment>
                    </field>
                    <field id="brand" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Brand</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Attributes</source_model>
                        <comment>Defines which attribute will be used to describe product brand.</comment>
                    </field>
                    <field id="manufacturer" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Manufacturer</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Attributes</source_model>
                        <comment>Defines which attribute will be used to describe product manufacturer.</comment>
                    </field>
                </group>
                <group id="delivery_data" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Delivery Data</label>
                    <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Defines if delivery data should be displayed in the structured data</comment>
                    </field>
                    <field id="business_days" translate="label" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Business Days</label>
                        <source_model>Magento\Config\Model\Config\Source\Locale\Weekdays</source_model>
                    </field>
                    <field id="cutoff_time" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Cutoff Time</label>
                        <comment>Time after which orders received that day are no longer processed. Example: 14:00 (24h format).</comment>
                    </field>
                    <field id="handling_time_value" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Handling Time</label>
                        <comment>Defines the time that is needed to pricess the order and ship the order. Accepted values are numbers or ranges e.g. 3 or 3-5</comment>
                    </field>
                    <field id="handling_time_unit_code" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Handling Time Unit Code</label>
                        <comment>Defines the unit of handling time (d - days, h - hours, min - minutes, s - seconds)</comment>
                    </field>
                    <field id="transit_time_value" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Transit Time</label>
                        <comment>Defines the time that is needed to pricess the order and ship the order. Accepted values are numbers or ranges e.g. 3 or 3-5</comment>
                    </field>
                    <field id="transit_time_unit_code" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Transit Time Unit Code</label>
                        <comment>Defines the unit of handling time (d - days, h - hours, min - minutes, s - seconds)</comment>
                    </field>
                </group>
                <group id="audience" translate="label" type="text" sortOrder="65" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Audience</label>
                    <field id="is_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <comment>Defines if audience should be displayed in the structured data</comment>
                    </field>
                    <field id="suggested_gender" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Suggested Gender</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Source\AudienceSuggestedGender</source_model>
                    </field>
                    <field id="suggested_gender_attribute" translate="label" type="select" sortOrder="21" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Gender: Attribute</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Attributes</source_model>
                        <comment>If set, reads gender from this product attribute. Expected values: male, female, unisex. Falls back to Suggested Gender if attribute value is empty or unrecognized.</comment>
                    </field>
                    <field id="suggested_min_age" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Suggested Min Age</label>
                        <comment>Default minimum age for the audience. Example: 3 (years).</comment>
                        <validate>validate-digits validate-greater-than-zero</validate>
                    </field>
                    <field id="suggested_min_age_attribute" translate="label" type="select" sortOrder="31" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                        <label>Min Age: Attribute</label>
                        <source_model>MageSuite\GoogleStructuredData\Model\Config\Attributes</source_model>
                        <comment>If set, reads minimum age from this product attribute. Expected value is a float (e.g. 3, 2.5). Falls back to Suggested Min Age if attribute value is empty.</comment>
                    </field>
                </group>
