<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="\Magento\Catalog\Block\Adminhtml\Product\Attribute\Edit\Tab\Front">
        <plugin name="add_google_structured_data" type="\MageSuite\GoogleStructuredData\Plugin\Adminhtml\Product\Attribuite\Edit\Tab\Front\AddGoogleStructuredData" sortOrder="200"/>
    </type>

    <type name="\MageSuite\GoogleStructuredData\Model\Config\Source\VariesByOptions">
        <arguments>
            <argument name="variesByTypes" xsi:type="array">
                <item name="color" xsi:type="string">https://schema.org/color</item>
                <item name="size" xsi:type="string">https://schema.org/size</item>
                <item name="suggestedAge" xsi:type="string">https://schema.org/suggestedAge</item>
                <item name="suggestedGender" xsi:type="string">https://schema.org/suggestedGender</item>
                <item name="material" xsi:type="string">https://schema.org/material</item>
                <item name="pattern" xsi:type="string">https://schema.org/pattern</item>
            </argument>
        </arguments>
    </type>
</config>
